# BreatheRoute environment variables
# Copy this file to .env and fill in your values.

# Required: Backend API URL (no trailing slash)
VITE_API_URL=

# Required: AWS region for Amazon Location Service
VITE_AWS_REGION=ap-south-1

# Required: Amazon Location Service API key
VITE_LOCATION_API_KEY=

# Optional: Map center as "longitude,latitude"
VITE_MAP_CENTER=78.07,11.10

# Optional: Default map zoom level (1-18)
VITE_MAP_ZOOM=13

# Optional: Restrict place search to bounding box "west,south,east,north"
VITE_DEMO_BOUNDS=
