# BreatheRoute frontend environment variables
VITE_API_URL=http://localhost:3001/api
VITE_MAPTILER_API_KEY=your_maptiler_api_key

# Optional: Map center as "longitude,latitude"
VITE_MAP_CENTER=78.07,11.10

# Optional: Default map zoom level (1-18)
VITE_MAP_ZOOM=13

# Optional: Restrict the demo AQI grid to "west,south,east,north"
VITE_DEMO_BOUNDS=
